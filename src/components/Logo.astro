---
/**
 * Logo du restaurant. Il suffit de déposer le fichier dans src/assets/brand/ sous le nom
 * logo.svg, logo.png ou logo.webp : il remplace automatiquement le logo texte provisoire.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  name: string;
  size?: string;
}

const { name, size = '4rem' } = Astro.props;

const files = import.meta.glob<ImageMetadata>('/src/assets/brand/logo.{svg,png,webp}', {
  eager: true,
  import: 'default',
});
const logo = Object.values(files)[0];
---

{logo ? (
  <Image
    src={logo}
    alt={name}
    class="logo-img"
    style={`--size: ${size}`}
    widths={[128, 256]}
    sizes={size}
  />
) : (
  <span class="wordmark" style={`--size: ${size}`} aria-label={name} role="img">
    <span class="wordmark__main" aria-hidden="true">
      Fat & Furious
    </span>
    <span class="wordmark__script" aria-hidden="true">
      Diner
    </span>
  </span>
)}

<style>
  :global(.logo-img) {
    height: var(--size);
    width: auto;
  }

  /* Logo texte provisoire, en attendant le fichier officiel */
  .wordmark {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    font-size: calc(var(--size) * 0.36);
    line-height: 1;
  }

  .wordmark__main {
    padding: 0.18em 0.45em 0.08em;
    background: var(--color-red);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-sm);
    color: var(--color-cream);
    font-family: var(--font-poster);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow: 2px 2px 0 var(--color-ink);
  }

  .wordmark__script {
    margin-top: -0.15em;
    padding: 0 0.5em;
    background: var(--color-ink);
    border-radius: var(--radius-pill);
    color: var(--color-cream);
    font-family: var(--font-script);
    font-size: 0.7em;
    line-height: 1.3;
  }
</style>
