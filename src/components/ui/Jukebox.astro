---
/**
 * Borne de jukebox années 50 (décor dessiné en SVG). Le contenu du slot (la photo du burger)
 * s'affiche dans la cloche en verre, en haut de la borne.
 * Toutes les cotes sont exprimées dans un repère de 400 × 520, converties en % pour rester fluides.
 * La cloche (x 66→334, y 66→338) apparaît trois fois : dans les deux SVG et dans .jukebox__dome.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Barreaux de la grille du haut-parleur.
const barreaux = Array.from({ length: 13 }, (_, i) => 100 + i * 16.5);
// Boutons de sélection.
const boutons = [96, 136, 176, 224, 264, 304];
---

<div class:list={['jukebox', className]}>
  <!-- Caisse, tubes néon, panneau et grille : derrière la photo -->
  <svg class="jukebox__body" viewBox="0 0 400 520" aria-hidden="true">
    <!-- ombre portée façon affiche -->
    <path d="M38 518V208a170 170 0 0 1 340 0v310z" fill="var(--color-ink)" />
    <!-- caisse -->
    <path
      d="M30 510V200a170 170 0 0 1 340 0v310z"
      fill="var(--color-red)"
      stroke="var(--color-ink)"
      stroke-width="6"
      stroke-linejoin="round"
    />
    <!-- tube néon rose le long de l'arche -->
    <path
      d="M52 336V200a148 148 0 0 1 296 0v136"
      fill="none"
      stroke="var(--color-pink)"
      stroke-width="16"
      stroke-linecap="round"
    />
    <path
      d="M52 336V200a148 148 0 0 1 296 0v136"
      fill="none"
      stroke="var(--color-pink-light)"
      stroke-width="5"
      stroke-linecap="round"
    />
    <!-- piliers teal -->
    <rect
      x="42"
      y="352"
      width="18"
      height="140"
      rx="9"
      fill="var(--color-teal)"
      stroke="var(--color-ink)"
      stroke-width="4"
    />
    <rect
      x="340"
      y="352"
      width="18"
      height="140"
      rx="9"
      fill="var(--color-teal)"
      stroke="var(--color-ink)"
      stroke-width="4"
    />
    <!-- fond de la cloche (visible autour d'une photo détourée) -->
    <path d="M66 338V200a134 134 0 0 1 268 0v138z" fill="var(--color-cream)" />
    <!-- panneau de sélection -->
    <rect
      x="72"
      y="350"
      width="256"
      height="40"
      rx="10"
      fill="var(--color-cream)"
      stroke="var(--color-ink)"
      stroke-width="4"
    />
    {boutons.map((x) => (
      <circle
        cx={x}
        cy="370"
        r="8"
        fill="var(--color-teal)"
        stroke="var(--color-ink)"
        stroke-width="3"
      />
    ))}
    <!-- grille du haut-parleur -->
    <rect x="82" y="402" width="236" height="84" rx="16" fill="var(--color-ink)" />
    {barreaux.map((x) => (
      <line
        x1={x}
        y1="412"
        x2={x}
        y2="476"
        stroke="var(--color-pink-light)"
        stroke-width="5"
        stroke-linecap="round"
      />
    ))}
    <!-- socle -->
    <rect x="18" y="500" width="364" height="18" rx="5" fill="var(--color-ink)" />
  </svg>

  <!-- La cloche en verre : la photo y est rognée en arche -->
  <div class="jukebox__dome">
    <slot />
  </div>

  <!-- Cadre chromé et reflet du verre : par-dessus la photo -->
  <svg class="jukebox__glass" viewBox="0 0 400 520" aria-hidden="true">
    <path
      d="M66 338V200a134 134 0 0 1 268 0v138z"
      fill="none"
      stroke="var(--color-ink)"
      stroke-width="7"
      stroke-linejoin="round"
    />
    <path
      d="M94 300V204a106 106 0 0 1 68-98"
      fill="none"
      stroke="var(--color-white)"
      stroke-width="10"
      stroke-linecap="round"
      opacity="0.55"
    />
    <path
      d="M110 296V214"
      stroke="var(--color-white)"
      stroke-width="5"
      stroke-linecap="round"
      opacity="0.4"
    />
  </svg>
</div>

<style>
  .jukebox {
    position: relative;
    aspect-ratio: 400 / 520;
  }

  .jukebox__body,
  .jukebox__glass {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .jukebox__glass {
    pointer-events: none;
  }

  /* Fenêtre de la cloche : x 66→334, y 66→338 dans le repère 400 × 520 */
  .jukebox__dome {
    position: absolute;
    left: 16.5%;
    top: 12.69%;
    width: 67%;
    height: 52.31%;
    overflow: hidden;
    border-radius: 50% 50% 0 0 / 49.26% 49.26% 0 0;
  }

  .jukebox__dome > :global(*) {
    width: 100%;
    height: 100%;
  }
</style>
