---
/** Squelette commun à toutes les pages : <head>, polices, styles globaux, balises SEO. */
import { Font, getImage } from 'astro:assets';
import { getBurgerDuMoment, getRestaurant } from '../lib/data';
import { restaurantJsonLd } from '../lib/seo';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Exclut la page de Google (ex. la planche du design system). */
  noindex?: boolean;
  /** Ajoute les données structurées du restaurant (page d'accueil). */
  jsonLd?: boolean;
}

const { title, description, noindex = false, jsonLd = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const [restaurant, burger] = await Promise.all([getRestaurant(), getBurgerDuMoment()]);

// Image de partage (Facebook, WhatsApp…) : la photo du burger du moment, sinon l'image par défaut.
const ogImage = burger.image
  ? new URL(
      (await getImage({ src: burger.image, width: 1200, height: 630, fit: 'cover', format: 'jpg' }))
        .src,
      site,
    )
  : new URL('/og-default.png', site);
const ogAlt = burger.image ? burger.imageAlt : restaurant.nom;

const structuredData = jsonLd ? await restaurantJsonLd(site, ogImage) : null;
---

<!doctype html>
<html lang="fr" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#3aa0ab" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={restaurant.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-poster" preload />
    <Font cssVariable="--font-script" />
    <Font cssVariable="--font-body" preload />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">
      Aller au contenu
    </a>
    <slot />
  </body>
</html>
