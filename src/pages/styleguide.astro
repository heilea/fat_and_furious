---
/** Planche du design system : page interne, non indexée et exclue du sitemap. */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Logo from '../components/Logo.astro';
import MenuCard from '../components/MenuCard.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Checker from '../components/ui/Checker.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Starburst from '../components/ui/Starburst.astro';
import Sunburst from '../components/ui/Sunburst.astro';
import { getMenu, getRestaurant } from '../lib/data';

const [restaurant, menu] = await Promise.all([getRestaurant(), getMenu()]);
const burgers = menu.find((c) => c.id === 'burgers');
const starters = menu.find((c) => c.id === 'starters');
const desserts = menu.find((c) => c.id === 'desserts');
const exemples = [
  ...(burgers?.produits.slice(0, 3) ?? []),
  ...(starters?.produits.filter((p) => p.tags.length) ?? []),
  ...(desserts?.produits.filter((p) => p.prixLibelle || p.tags.length) ?? []),
];

const couleurs = [
  { token: '--color-teal', usage: 'Couleur signature, fonds de section' },
  { token: '--color-teal-dark', usage: 'Texte teal sur fond clair, liens' },
  { token: '--color-teal-deep', usage: 'Bandeaux néon de la carte' },
  { token: '--color-neon', usage: 'Lettres néon' },
  { token: '--color-red', usage: 'Titres script, boutons, prix' },
  { token: '--color-red-dark', usage: 'Survol du rouge' },
  { token: '--color-cream', usage: 'Fond principal, contours' },
  { token: '--color-paper', usage: 'Fond des cartes et du menu' },
  { token: '--color-ink', usage: 'Texte, contours, ombres' },
  { token: '--color-muted', usage: 'Texte secondaire' },
];
---

<Base title="Design system · Fat & Furious" description="Planche interne du design system." noindex>
  <header class="sg-header">
    <div class="container sg-header__inner">
      <Logo name={restaurant.nom} size="4.5rem" />
      <div>
        <p class="sg-kicker">Page interne · non indexée</p>
        <h1 class="sg-h1">Design system</h1>
      </div>
    </div>
  </header>

  <main id="contenu">
    <section class="sg-section container">
      <h2 class="sg-h2">Couleurs</h2>
      <p class="sg-note">
        Relevées sur les visuels Instagram, Facebook et la carte. Définies une seule fois dans{' '}
        <code>src/styles/tokens.css</code>.
      </p>
      <ul class="swatches">
        {couleurs.map(({ token, usage }) => (
          <li class="swatch">
            <span class="swatch__chip" style={`background: var(${token})`} />
            <code class="swatch__token">{token}</code>
            <code class="swatch__hex" data-token={token} />
            <span class="swatch__usage">{usage}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="sg-section container">
      <h2 class="sg-h2">Typographies</h2>
      <div class="type-grid">
        <div>
          <p class="sg-label">Affiche · Bebas Neue</p>
          <p class="type-poster">Burgers XXL · Hot-dogs · Milkshakes</p>
        </div>
        <div>
          <p class="sg-label">Script · Lobster</p>
          <p class="type-script">Le goût de l'Amérique</p>
        </div>
        <div>
          <p class="sg-label">Texte · Inter</p>
          <p class="type-body">{restaurant.description}</p>
        </div>
      </div>
    </section>

    <section class="sg-section container">
      <h2 class="sg-h2">Titres de section</h2>
      <div class="stack">
        <SectionTitle variant="neon" title="Milkshakes" as="h3" />
        <SectionTitle script="Le goût de l'Amérique" title="à Tahiti" as="h3" />
      </div>
    </section>

    <section class="sg-section container">
      <h2 class="sg-h2">Boutons et pastilles</h2>
      <div class="row">
        <Button href="#">Voir le menu</Button>
        <Button href="#" variant="secondary">
          Nous trouver
        </Button>
        <Button href="#" variant="light">
          Instagram
        </Button>
      </div>
      <div class="row">
        <Badge>Signature</Badge>
        <Badge tone="teal">À partager</Badge>
        <Badge tone="ink">Sans réservation</Badge>
      </div>
      <div class="row">
        <Starburst>New</Starburst>
        <Starburst tone="cream" tilt={8}>
          XXL
        </Starburst>
        <Starburst tone="teal" tilt={-4} size="8rem">
          5 500 XPF
        </Starburst>
      </div>
    </section>

    <section class="sg-section container">
      <h2 class="sg-h2">Motifs</h2>
      <div class="stack">
        <Checker />
        <Checker a="var(--color-red)" b="var(--color-white)" />
        <Checker a="var(--color-ink)" b="var(--color-cream)" rows={1} />
        <div class="sunburst-demo">
          <Sunburst />
        </div>
      </div>
    </section>

    <section class="sg-section">
      <div class="container">
        <h2 class="sg-h2">Bannière : burger du moment</h2>
        <p class="sg-note">
          Pilotée par <code>src/data/burger-du-moment.yaml</code>.
        </p>
      </div>
      <Hero />
    </section>

    <section class="sg-section container">
      <h2 class="sg-h2">Lignes de la carte</h2>
      <p class="sg-note">
        Exemples tirés de <code>src/data/menu.yaml</code>.
      </p>
      <div class="menu-demo">
        <SectionTitle variant="neon" title="Burgers" as="h3" />
        {burgers?.note && <p class="menu-demo__note">{burgers.note}</p>}
        <div class="menu-demo__list">
          {exemples.map((produit) => (
            <MenuCard {...produit} devise={restaurant.devise} />
          ))}
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Affiche la valeur réelle de chaque couleur, lue dans tokens.css (une seule source de vérité).
  const styles = getComputedStyle(document.documentElement);
  document.querySelectorAll<HTMLElement>('[data-token]').forEach((el) => {
    el.textContent = styles.getPropertyValue(el.dataset.token ?? '').trim();
  });
</script>

<style>
  .sg-header {
    padding-block: var(--space-6);
    background: var(--color-teal);
    color: var(--color-white);
  }

  .sg-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .sg-kicker {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .sg-h1 {
    font-size: var(--text-2xl);
  }

  .sg-section {
    padding-block: var(--space-7);
    border-bottom: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  .sg-h2 {
    margin-bottom: var(--space-2);
    font-size: var(--text-xl);
  }

  .sg-note,
  .sg-label {
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .sg-label {
    margin-bottom: var(--space-2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .swatch {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-xs);
  }

  .swatch__chip {
    height: 4.5rem;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-md);
  }

  .swatch__token {
    font-weight: 700;
  }

  .swatch__hex {
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .type-grid {
    display: grid;
    gap: var(--space-6);
  }

  .type-poster {
    font-family: var(--font-poster);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .type-script {
    font-family: var(--font-script);
    font-size: var(--text-2xl);
    line-height: 1.1;
    color: var(--color-red);
  }

  .type-body {
    max-width: 60ch;
  }

  .stack {
    display: grid;
    gap: var(--space-6);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }

  .sunburst-demo {
    position: relative;
    height: 12rem;
    overflow: hidden;
    border: var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .menu-demo {
    max-width: 44rem;
    margin-inline: auto;
    padding: var(--space-6) var(--gutter);
    background: var(--bg-card);
    border: var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-poster-lg);
  }

  .menu-demo__note {
    margin-top: var(--space-4);
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-teal-dark);
  }

  .menu-demo__list {
    margin-top: var(--space-4);
  }
</style>
